+void FileAccessUnix::flush() {
+	ERR_FAIL_NULL_MSG(f, "File must be opened before use.");
+#if defined(WEB_ENABLED) && defined(__EMSCRIPTEN_GLX__)
+	if (fflush(f) != 0) {
+		last_error = ERR_FILE_CANT_WRITE;
+	}
+	// Successful stdio flushing does not prove native persistence or clear errors.
+#else
+	fflush(f);
+#endif
+}
 
