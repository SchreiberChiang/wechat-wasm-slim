+	const int close_error = fclose(f);
+	f = nullptr; // fclose consumes FILE even when it reports failure.
+
+	if (close_error != 0 || had_write_error) {
+		last_error = (closed_flags & WRITE) ? ERR_FILE_CANT_WRITE : ERR_FILE_CANT_READ;
