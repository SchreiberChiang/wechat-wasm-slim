 void FileAccessUnix::_close() {
+#if defined(WEB_ENABLED) && defined(WECHAT_GLX_EXPERIMENTAL)
+	if (!f) {
+		// A failed open may have left a target without a live FILE.
+		save_path = "";
+		return; // Keep the last close/flush error available after repeated close().
+	}
+
+	const String closed_path = path;
+	const String target_path = save_path;
+	const int closed_flags = flags;
+	// This target belongs to this close only, including all failure exits.
+	save_path = "";
