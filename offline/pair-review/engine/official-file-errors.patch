+		if (close_fail_notify) {
+			close_fail_notify(target_path.is_empty() ? closed_path : target_path);
+		}
+		return; // Never replace the destination after a failed write/close.
+	}
+
+	if (close_notification_func) {
+		close_notification_func(closed_path, closed_flags);
