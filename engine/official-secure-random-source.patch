+namespace {
+static mbedtls_ctr_drbg_context wxslim_random_context;
+static unsigned char wxslim_random_output[1024];
+static bool wxslim_random_initialized = false;
+static bool wxslim_random_busy = false;
+static bool wxslim_random_failed = false;
+static bool wxslim_random_seeded = false;
+static void wxslim_random_zero(unsigned char *p_buffer, size_t p_size) {
+	volatile unsigned char *out = p_buffer;
+	while (p_size--) {
+		*out++ = 0;
+	}
+}
+static void wxslim_random_stop() {
+	wxslim_random_failed = true;
+	wxslim_random_zero(wxslim_random_output, sizeof(wxslim_random_output));
+	// A reentrant stop latches immediately; the outer operation frees on unwind.
+	if (wxslim_random_initialized && !wxslim_random_busy) {
+		mbedtls_ctr_drbg_free(&wxslim_random_context);
+		wxslim_random_zero(reinterpret_cast<unsigned char *>(&wxslim_random_context), sizeof(wxslim_random_context));
+		wxslim_random_initialized = false;
+	}
+}
+static int wxslim_random_entropy(void *, unsigned char *p_buffer, size_t p_size) {
+	if (wxslim_random_failed || p_size != 48 || godot_js_wechat_entropy_take(p_buffer, 48) != 0) {
+		wxslim_random_zero(p_buffer, p_size);
+		return MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED;
+	}
+	return 0;
+}
+} // namespace
+// wasm32 ABI: size=0 permanently terminates; 1..1024 returns private output or 0.
+extern "C" unsigned char *godot_wechat_random_buffer(int p_size) {
+	if (p_size == 0 || p_size < 0 || p_size > 1024 || wxslim_random_failed || wxslim_random_busy) {
+		wxslim_random_stop();
+		return nullptr;
+	}
+	wxslim_random_busy = true;
+	if (!wxslim_random_initialized) {
+		mbedtls_ctr_drbg_init(&wxslim_random_context);
+		wxslim_random_initialized = true;
+		mbedtls_ctr_drbg_set_entropy_len(&wxslim_random_context, 48);
+	}
+	int result = 0;
+	if (!wxslim_random_seeded) {
+		result = mbedtls_ctr_drbg_seed(&wxslim_random_context, wxslim_random_entropy, nullptr, nullptr, 0);
+		wxslim_random_seeded = result == 0;
+	}
+	wxslim_random_zero(wxslim_random_output, sizeof(wxslim_random_output));
+	if (result == 0 && !wxslim_random_failed) {
+		result = mbedtls_ctr_drbg_random(&wxslim_random_context, wxslim_random_output, static_cast<size_t>(p_size));
+	}
+	wxslim_random_busy = false;
+	if (result != 0 || wxslim_random_failed) {
+		wxslim_random_stop();
+		return nullptr;
+	}
+	return wxslim_random_output;
+}
