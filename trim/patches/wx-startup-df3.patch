+void ShaderGLES3::_free_specialization(Version::Specialization &spec) {
+	if (spec.vert_id != 0) {
+		glDeleteShader(spec.vert_id);
+	}
+	if (spec.frag_id != 0) {
+		glDeleteShader(spec.frag_id);
+	}
+	if (spec.id != 0) {
+		glDeleteProgram(spec.id);
+	}
+	spec.vert_id = 0;
+	spec.frag_id = 0;
+	spec.id = 0;
+	spec.ok = false;
+	spec.build_queued = false;
+#ifdef WX_LAB_SHADER_TRACE
+	spec.first_bind_reported = false;
+	spec.compiled_specialization = 0;
+#endif
+	spec.uniform_location.clear();
+	spec.texture_uniform_locations.clear();
+}
