+// Opt-in lab timings measure host wall time of GL API calls. Status queries
+// can include driver synchronization; these are not GPU timer-query results.
+class WxShaderCompileTrace {
+public:
+	enum Phase { BUILD_SOURCE, SHADER_SOURCE, COMPILE_SUBMIT, COMPILE_STATUS, FEEDBACK_SETUP, LINK_SUBMIT, LINK_STATUS, UNIFORMS, PHASE_MAX };
+#ifdef WX_LAB_SHADER_TRACE
+private:
+	CharString shader_name;
+	uint32_t variant;
+	uint64_t specialization;
+	const bool &ok;
+	uint64_t started;
+	uint64_t elapsed[PHASE_MAX] = {};
+	uint32_t calls[PHASE_MAX] = {};
+	static uint32_t records;
+	static uint64_t attempts;
+public:
+	WxShaderCompileTrace(const String &p_name, uint32_t p_variant, uint64_t p_specialization, const bool &p_ok) : shader_name(p_name.utf8()), variant(p_variant), specialization(p_specialization), ok(p_ok), started(OS::get_singleton()->get_ticks_usec()) {}
+	template <class F> void measure(Phase p_phase, F p_call) {
+		const uint64_t begin = OS::get_singleton()->get_ticks_usec();
+		p_call();
+		elapsed[p_phase] += OS::get_singleton()->get_ticks_usec() - begin;
+		calls[p_phase]++;
+	}
+	~WxShaderCompileTrace() {
+		const uint64_t total = OS::get_singleton()->get_ticks_usec() - started;
+		attempts++;
+		if (records++ >= 256) {
+			return;
+		}
+		std::printf("[WX_SHADER_COMPILE] {\"shader\":\"%s\",\"variant\":%u,\"specialization\":%llu,\"attempt\":%llu,\"ok\":%s,\"total_us\":%llu,\"phase_us\":[", shader_name.get_data(), variant, (unsigned long long)specialization, (unsigned long long)attempts, ok ? "true" : "false", (unsigned long long)total);
+		for (int i = 0; i < PHASE_MAX; i++) {
+			std::printf("%s%llu", i ? "," : "", (unsigned long long)elapsed[i]);
+		}
+		std::printf("],\"phase_calls\":[");
+		for (int i = 0; i < PHASE_MAX; i++) {
+			std::printf("%s%u", i ? "," : "", calls[i]);
+		}
+		std::printf("]}\n");
+	}
+#else
+	WxShaderCompileTrace(const String &, uint32_t, uint64_t, const bool &) {}
+	template <class F> void measure(Phase, F p_call) { p_call(); }
+#endif
+};
