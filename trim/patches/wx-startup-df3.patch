@@ -0,0 +1,21 @@
+#pragma once
+
+#if defined(WX_LAB_RUNTIME_PREWARM_POLICY)
+#if !defined(WEB_ENABLED) || !defined(GLES3_ENABLED) || !defined(WX_LAB_STARTUP_TRACE) || defined(THREADS_ENABLED) || defined(_3D_DISABLED) || defined(WX_LAB_SKIP_3D_PREWARM)
+#error "Runtime prewarm experiment requires full-3D GLES3 Web, trace, threads=no and no compile-time skip"
+#endif
+
+#include "core/object/ref_counted.h"
+#include "core/variant/dictionary.h"
+
+// Experiment-only interface. No network, input, shader source or user data.
+class WxLabStartupControl : public RefCounted {
+    GDCLASS(WxLabStartupControl, RefCounted);
+
+protected:
+    static void _bind_methods();
+
+public:
+    Dictionary prewarm_default_3d_shader();
+};
+#endif
diff --git a/platform/web/wx_lab_startup_trace.h b/platform/web/wx_lab_startup_trace.h
new file mode 100644
--- /dev/null
+++ b/platform/web/wx_lab_startup_trace.h
@@ -0,0 +1,197 @@
+#ifndef WX_LAB_STARTUP_TRACE_H
+#define WX_LAB_STARTUP_TRACE_H
+
+#if !defined(WX_LAB_STARTUP_TRACE) || !defined(WEB_ENABLED)
+#error WxLabStartupTrace is opt-in and Web-only
+#endif
+#ifdef THREADS_ENABLED
+#error WxLabStartupTrace requires the reviewed single-thread experiment
+#endif
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <limits>
+
+// Local, single-thread startup experiment. No allocation, shader text or GL calls.
+class WxLabStartupTrace {
+public:
+    using Clock = bool (*)(int64_t &);
+    using Emit = void (*)(const char *);
+    static constexpr int CAPACITY = 24;
+    static constexpr int JSON_CAPACITY = 2800;
+
+private:
+#ifdef WX_LAB_SKIP_3D_PREWARM
+    static constexpr bool SKIP_3D_PREWARM = true;
+#else
+    static constexpr bool SKIP_3D_PREWARM = false;
+#endif
+    struct Record {
+        const char *label;
+        int parent;
+        int64_t start;
+        int64_t end;
+        bool start_valid;
+        bool end_valid;
+        bool closed;
+    };
+    inline static Record rows_[CAPACITY] = {};
+    inline static int stack_[CAPACITY] = {};
+    inline static int count_ = 0, depth_ = 0, dropped_ = 0, clock_errors_ = 0;
+    inline static int64_t origin_ = 0, previous_ = 0;
+    inline static bool have_origin_ = false, active_ = false, emitted_ = false;
+    inline static bool balanced_ = true, labels_valid_ = true, main_success_ = false;
+    inline static bool runtime_policy_observed_ = false, runtime_policy_skipped_ = false;
+#ifdef WX_LAB_RUNTIME_PREWARM_POLICY
+    static constexpr const char *RUNTIME_POLICY_NAME = "project_setting_v1";
+#else
+    static constexpr const char *RUNTIME_POLICY_NAME = "not_enabled";
+#endif
+    inline static Clock clock_ = nullptr;
+    inline static Emit emit_ = nullptr;
+
+    static bool default_clock(int64_t &out) {
+        timespec ts = {};
+        if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0 || ts.tv_sec < 0 ||
+                ts.tv_nsec < 0 || ts.tv_nsec >= 1000000000 ||
+                static_cast<uint64_t>(ts.tv_sec) > static_cast<uint64_t>((INT64_MAX - ts.tv_nsec / 1000) / 1000000)) {
+            return false;
+        }
+        out = static_cast<int64_t>(ts.tv_sec) * 1000000 + ts.tv_nsec / 1000;
+        return true;
+    }
+    static void default_emit(const char *json) { std::printf("[WX_NATIVE_STARTUP] %s\n", json); }
+    static const char *allowed_label(const char *label) {
+        static const char *const labels[] = {
+            "webmain_total", "main_setup", "main_start", "scene_tree_initialize",
+            "first_main_loop_callback", "first_rendering_draw", "display_server_create", "rendering_server_init",
+            "theme_and_default_font", "main_scene_load", "main_scene_instantiate",
+            "main_scene_add", "gles3_scene_ctor", "gles3_scene_default3d_prewarm"
+        };
+        if (label) for (const char *known : labels) if (std::strcmp(label, known) == 0) return known;
+        labels_valid_ = false;
+        return "unknown_scope"; // Never serialize caller-provided text.
+    }
+    static bool sample(int64_t &out) {
+        int64_t now = 0;
+        if (!clock_ || !clock_(now) || now < 0 || (have_origin_ && now < previous_)) {
+            ++clock_errors_;
+            return false;
+        }
+        if (!have_origin_) { origin_ = now; have_origin_ = true; }
+        previous_ = now;
+        out = now - origin_;
+        return true;
+    }
+    static int enter(const char *label) {
+        if (!active_) return -1;
+        if (count_ >= CAPACITY || depth_ >= CAPACITY) { ++dropped_; return -1; }
+        const int index = count_++;
+        Record &r = rows_[index];
+        r.label = allowed_label(label);
+        r.parent = depth_ ? stack_[depth_ - 1] + 1 : 0;
+        r.start_valid = sample(r.start);
+        stack_[depth_++] = index;
+        return index;
+    }
+    static void leave(int index) {
+        if (!active_ || index < 0 || index >= count_ || rows_[index].closed) return;
+        if (!depth_ || stack_[depth_ - 1] != index) { balanced_ = false; return; }
+        --depth_;
+        Record &r = rows_[index];
+        r.end_valid = sample(r.end);
+        r.closed = true;
+    }
+
+public:
+    // Read-only shared clock origin; no new sample or change to the v1 payload.
+    static bool get_origin_us(int64_t &out) {
+        if (!have_origin_) return false;
+        out = origin_;
+        return true;
+    }
+    static void initialize(Clock clock = nullptr, Emit emit = nullptr) {
+        count_ = depth_ = dropped_ = clock_errors_ = 0;
+        origin_ = previous_ = 0;
+        have_origin_ = active_ = emitted_ = main_success_ = false;
+        balanced_ = labels_valid_ = true;
+        runtime_policy_observed_ = runtime_policy_skipped_ = false;
+        clock_ = clock ? clock : default_clock;
+        emit_ = emit ? emit : default_emit;
+        for (Record &r : rows_) r = {};
+    }
+    static void start() {
+        if (active_ || emitted_) return;
+        active_ = true;
+        enter("webmain_total");
+    }
+    static void set_main_success(bool success) { main_success_ = success; }
+    static void set_runtime_prewarm_policy(bool skip) {
+        if (!active_ || emitted_) return;
+        runtime_policy_observed_ = true; runtime_policy_skipped_ = skip;
+    }
+    static void finish() {
+        if (!active_ || emitted_) return;
+        if (depth_ != 1 || !count_ || stack_[0] != 0) balanced_ = false;
+        // Close remaining rows for failure evidence; balanced=false rejects the run.
+        while (depth_) leave(stack_[depth_ - 1]);
+        active_ = false;
+        emitted_ = true;
+        const bool clock_valid = have_origin_ && clock_errors_ == 0;
+        const bool complete = main_success_ && clock_valid && balanced_ && labels_valid_ && dropped_ == 0;
+        char json[JSON_CAPACITY] = {};
+        int used = std::snprintf(json, sizeof(json),
+                "{\"schema\":\"wx-native-startup-v1\",\"source_pin\":\"df3cdd9bc9941a20cb5575d781cde6f937637bcb\","
+                "\"skip_3d_prewarm\":%s,\"main_success\":%s,\"complete\":%s,\"clock\":\"%s\",\"unit\":\"us\","
+                "\"runtime_prewarm_policy\":\"%s\",\"runtime_default_3d_prewarm_policy_observed\":%s,\"runtime_default_3d_prewarm_skipped\":%s,"
+                "\"clock_valid\":%s,\"clock_errors\":%d,\"balanced\":%s,\"labels_valid\":%s,\"dropped\":%d,\"records\":[",
+                SKIP_3D_PREWARM ? "true" : "false", main_success_ ? "true" : "false", complete ? "true" : "false",
+                clock_ == default_clock ? "clock_gettime(CLOCK_MONOTONIC)" : "injected_fake_clock",
+                RUNTIME_POLICY_NAME, runtime_policy_observed_ ? "true" : "false", runtime_policy_skipped_ ? "true" : "false",
+                clock_valid ? "true" : "false", clock_errors_, balanced_ ? "true" : "false", labels_valid_ ? "true" : "false", dropped_);
+        bool overflow = used < 0 || used >= JSON_CAPACITY;
+        for (int i = 0; i < count_ && !overflow; ++i) {
+            const Record &r = rows_[i];
+            const bool valid = r.start_valid && r.end_valid && r.closed && r.end >= r.start;
+            char start[32], duration[32];
+            if (r.start_valid) std::snprintf(start, sizeof(start), "%lld", static_cast<long long>(r.start));
+            else std::strcpy(start, "null");
+            if (valid) std::snprintf(duration, sizeof(duration), "%lld", static_cast<long long>(r.end - r.start));
+            else std::strcpy(duration, "null");
+            const int wrote = std::snprintf(json + used, sizeof(json) - used,
+                    "%s{\"id\":%d,\"parent\":%d,\"label\":\"%s\",\"start_us\":%s,\"duration_us\":%s,\"complete\":%s}",
+                    i ? "," : "", i + 1, r.parent, r.label, start, duration, valid ? "true" : "false");
+            overflow = wrote < 0 || wrote >= JSON_CAPACITY - used;
+            if (!overflow) used += wrote;
+        }
+        if (!overflow) {
+            const int wrote = std::snprintf(json + used, sizeof(json) - used, "]}");
+            overflow = wrote < 0 || wrote >= JSON_CAPACITY - used;
+        }
+        if (overflow) {
+            std::snprintf(json, sizeof(json),
+                    "{\"schema\":\"wx-native-startup-v1\",\"skip_3d_prewarm\":%s,\"main_success\":%s,"
+                    "\"complete\":false,\"serialization_overflow\":true,\"runtime_prewarm_policy\":\"%s\",\"runtime_default_3d_prewarm_policy_observed\":%s,\"runtime_default_3d_prewarm_skipped\":%s,\"records\":[]}",
+                    SKIP_3D_PREWARM ? "true" : "false", main_success_ ? "true" : "false",
+                    RUNTIME_POLICY_NAME, runtime_policy_observed_ ? "true" : "false", runtime_policy_skipped_ ? "true" : "false");
+        }
+        emit_(json);
+    }
+    class Scope {
+        int index_;
+    public:
+        explicit Scope(const char *label) : index_(enter(label)) {}
+        Scope(const Scope &) = delete;
+        Scope &operator=(const Scope &) = delete;
+        void stop() { leave(index_); index_ = -1; }
+        void finish() { stop(); }
+        ~Scope() { stop(); }
+    };
+    class FinishOnReturn {
+    public:
+        ~FinishOnReturn() { WxLabStartupTrace::finish(); }
+    };
+};
+#endif
