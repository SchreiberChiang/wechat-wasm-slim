diff --git a/platform/web/wx_lab_setup_detail.h b/platform/web/wx_lab_setup_detail.h
new file mode 100644
--- /dev/null
+++ b/platform/web/wx_lab_setup_detail.h
@@ -0,0 +1,170 @@
+#ifndef WX_LAB_SETUP_DETAIL_H
+#define WX_LAB_SETUP_DETAIL_H
+
+#if !defined(WX_LAB_STARTUP_TRACE) || !defined(WEB_ENABLED)
+#error WxLabSetupDetail is opt-in and Web-only
+#endif
+#ifdef THREADS_ENABLED
+#error WxLabSetupDetail requires the reviewed single-thread experiment
+#endif
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <climits>
+
+// Fixed storage and two monotonic reads per scope. Emit only after native finish.
+class WxLabSetupDetail {
+public:
+	using Clock = bool (*)(int64_t &);
+	using Emit = void (*)(const char *);
+	static constexpr int CAPACITY = 16;
+	static constexpr int JSON_CAPACITY = 4096;
+	static constexpr int64_t MAX_JSON_INTEGER = 9007199254740991LL;
+
+private:
+	struct Record {
+		const char *label;
+		int parent;
+		int64_t start, end;
+		bool start_valid, end_valid, closed;
+	};
+	inline static Record rows_[CAPACITY] = {};
+	inline static int stack_[CAPACITY] = {};
+	inline static int count_ = 0, depth_ = 0, dropped_ = 0, clock_errors_ = 0;
+	inline static int64_t origin_ = 0, previous_ = 0;
+	inline static bool origin_valid_ = false, active_ = false, emitted_ = false;
+	inline static bool balanced_ = true, labels_valid_ = true, order_valid_ = true;
+	inline static bool setup_success_ = false, main_success_ = false;
+	inline static Clock clock_ = nullptr;
+	inline static Emit emit_ = nullptr;
+	inline static constexpr const char *labels_[14] = {
+		"setup_phase1", "os_initialize", "core_type_registration", "project_pack_setup",
+		"core_modules_extensions", "uid_autoload_cache", "setup_phase2", "server_types_modules",
+		"audio_driver_server", "translations_remaps", "text_server_setup", "scene_type_registration",
+		"scene_modules_extensions", "finalize_setup"
+	};
+	static void increment(int &counter) { if (counter < INT_MAX) ++counter; }
+	static bool default_clock(int64_t &out) {
+		timespec ts = {};
+		if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0 || ts.tv_sec < 0 ||
+				ts.tv_nsec < 0 || ts.tv_nsec >= 1000000000 ||
+				static_cast<uint64_t>(ts.tv_sec) > static_cast<uint64_t>((INT64_MAX - ts.tv_nsec / 1000) / 1000000)) return false;
+		out = static_cast<int64_t>(ts.tv_sec) * 1000000 + ts.tv_nsec / 1000;
+		return true;
+	}
+	static void default_emit(const char *json) { std::printf("[WX_NATIVE_SETUP_DETAIL] %s\n", json); }
+	static const char *allowed_label(const char *label) {
+		if (label) for (const char *known : labels_) if (std::strcmp(label, known) == 0) return known;
+		labels_valid_ = false;
+		return "unknown_scope"; // Never emit arbitrary caller text.
+	}
+	static bool sample(int64_t &out) {
+		int64_t now = 0;
+		if (!clock_ || !clock_(now) || !origin_valid_ || now < previous_ || now < origin_ ||
+				now - origin_ > MAX_JSON_INTEGER) {
+			increment(clock_errors_);
+			return false;
+		}
+		previous_ = now;
+		out = now - origin_;
+		return true;
+	}
+	static int enter(const char *label) {
+		if (!active_) return -1;
+		if (count_ >= CAPACITY || depth_ >= CAPACITY) { increment(dropped_); return -1; }
+		const int index = count_++;
+		Record &r = rows_[index];
+		r.label = allowed_label(label);
+		r.parent = depth_ ? stack_[depth_ - 1] + 1 : 0;
+		const int expected_parent = index == 0 || index == 6 ? 0 : (index < 6 ? 1 : 7);
+		if (index >= 14 || r.label != labels_[index] || r.parent != expected_parent) order_valid_ = false;
+		r.start_valid = sample(r.start);
+		stack_[depth_++] = index;
+		return index;
+	}
+	static bool leave(int index) {
+		if (!active_ || index < 0 || index >= count_ || rows_[index].closed) return true;
+		if (!depth_ || stack_[depth_ - 1] != index) { balanced_ = false; return false; }
+		--depth_;
+		Record &r = rows_[index];
+		r.end_valid = sample(r.end);
+		r.closed = true;
+		return true;
+	}
+	static bool serialize(char *json, int capacity, bool overflow_only) {
+		const bool clock_valid = origin_valid_ && clock_errors_ == 0;
+		const bool complete = !overflow_only && main_success_ && setup_success_ && clock_valid &&
+				balanced_ && labels_valid_ && order_valid_ && count_ == 14 && dropped_ == 0;
+		char origin[32];
+		if (origin_valid_) std::snprintf(origin, sizeof(origin), "%lld", static_cast<long long>(origin_));
+		else std::strcpy(origin, "null");
+		int used = std::snprintf(json, capacity,
+				"{\"schema\":\"wx-native-setup-detail-v1\",\"source_pin\":\"df3cdd9bc9941a20cb5575d781cde6f937637bcb\","
+				"\"main_success\":%s,\"setup_success\":%s,\"complete\":%s,\"clock\":\"%s\",\"unit\":\"us\","
+				"\"origin\":\"wx-native-startup-v1\",\"origin_us\":%s,\"clock_valid\":%s,\"clock_errors\":%d,"
+				"\"balanced\":%s,\"labels_valid\":%s,\"order_valid\":%s,\"dropped\":%d,\"serialization_overflow\":%s,\"records\":[",
+				main_success_ ? "true" : "false", setup_success_ ? "true" : "false", complete ? "true" : "false",
+				clock_ == default_clock ? "clock_gettime(CLOCK_MONOTONIC)" : "injected_fake_clock", origin,
+				clock_valid ? "true" : "false", clock_errors_, balanced_ ? "true" : "false",
+				labels_valid_ ? "true" : "false", order_valid_ ? "true" : "false", dropped_, overflow_only ? "true" : "false");
+		if (used < 0 || used >= capacity) return false;
+		for (int i = 0; i < count_ && !overflow_only; ++i) {
+			const Record &r = rows_[i];
+			const bool valid = r.start_valid && r.end_valid && r.closed && r.end >= r.start;
+			char start[32], duration[32];
+			if (r.start_valid) std::snprintf(start, sizeof(start), "%lld", static_cast<long long>(r.start));
+			else std::strcpy(start, "null");
+			if (valid) std::snprintf(duration, sizeof(duration), "%lld", static_cast<long long>(r.end - r.start));
+			else std::strcpy(duration, "null");
+			const int wrote = std::snprintf(json + used, capacity - used,
+					"%s{\"id\":%d,\"parent\":%d,\"label\":\"%s\",\"start_us\":%s,\"duration_us\":%s,\"complete\":%s}",
+					i ? "," : "", i + 1, r.parent, r.label, start, duration, valid ? "true" : "false");
+			if (wrote < 0 || wrote >= capacity - used) return false;
+			used += wrote;
+		}
+		const int wrote = std::snprintf(json + used, capacity - used, "]}");
+		return wrote >= 0 && wrote < capacity - used;
+	}
+
+public:
+	static void initialize(bool origin_valid, int64_t origin, Clock clock = nullptr, Emit emit = nullptr) {
+		count_ = depth_ = dropped_ = clock_errors_ = 0;
+		origin_valid_ = origin_valid && origin >= 0 && origin <= MAX_JSON_INTEGER;
+		origin_ = previous_ = origin_valid_ ? origin : 0;
+		active_ = true; emitted_ = setup_success_ = main_success_ = false;
+		balanced_ = labels_valid_ = order_valid_ = true;
+		clock_ = clock ? clock : default_clock; emit_ = emit ? emit : default_emit;
+		for (Record &r : rows_) r = {};
+	}
+	static void set_setup_success(bool success) { setup_success_ = success; }
+	static void set_main_success(bool success) { main_success_ = success; }
+	static void finish() {
+		if (!active_ || emitted_) return;
+		if (depth_) balanced_ = false;
+		while (depth_) leave(stack_[depth_ - 1]);
+		active_ = false; emitted_ = true;
+		char json[JSON_CAPACITY] = {};
+		if (!serialize(json, sizeof(json), false)) serialize(json, sizeof(json), true);
+		emit_(json);
+	}
+	class Scope {
+		int index_;
+	public:
+		Scope() : index_(-1) {}
+		explicit Scope(const char *label) : index_(enter(label)) {}
+		Scope(const Scope &) = delete;
+		Scope &operator=(const Scope &) = delete;
+		void start(const char *label) { if (index_ < 0) index_ = enter(label); }
+		void stop() { if (leave(index_)) index_ = -1; }
+		~Scope() { stop(); }
+	};
+	class FinishAfterNative {
+	public:
+		~FinishAfterNative() { WxLabSetupDetail::finish(); }
+	};
+	// Friend exists only for the standalone adversarial fixture, without runtime API.
+	friend struct WxLabSetupDetailFixture;
+};
+#endif
diff --git a/platform/web/wx_lab_startup_control.cpp b/platform/web/wx_lab_startup_control.cpp
new file mode 100644
--- /dev/null
+++ b/platform/web/wx_lab_startup_control.cpp
@@ -0,0 +1,64 @@
+#include "wx_lab_startup_control.h"
+
+#if defined(WX_LAB_RUNTIME_PREWARM_POLICY)
+#include "core/object/class_db.h"
+#include "core/os/os.h"
+#include "drivers/gles3/rasterizer_scene_gles3.h"
+#include "servers/rendering/rendering_server.h"
+#include <cstdio>
+#include <limits>
+
+void WxLabStartupControl::_bind_methods() {
+    ClassDB::bind_method(D_METHOD("prewarm_default_3d_shader"), &WxLabStartupControl::prewarm_default_3d_shader);
+}
+
+Dictionary WxLabStartupControl::prewarm_default_3d_shader() {
+    OS *os = OS::get_singleton();
+    const uint64_t before = os ? os->get_ticks_usec() : 0;
+    RenderingServer *server = RenderingServer::get_singleton();
+    RasterizerSceneGLES3 *scene = RasterizerSceneGLES3::get_singleton();
+    const char *status = "unavailable";
+    const char *error_code = "";
+    bool available = false, performed = false;
+
+    if (!os) {
+        error_code = "NO_OS_TIMER";
+    } else if (!server) {
+        error_code = "NO_RENDER_SERVER";
+    } else if (!server->is_on_render_thread()) {
+        error_code = "WRONG_RENDER_THREAD"; // No GL access or asynchronous success claim.
+    } else if (!scene) {
+        error_code = "NO_GLES3_SCENE";
+    } else {
+        available = true;
+        if (scene->wx_lab_default_3d_prewarm_attempted()) {
+            status = scene->wx_lab_default_3d_prewarm_succeeded() ? "already_warm" : "error";
+            if (!scene->wx_lab_default_3d_prewarm_succeeded()) error_code = "PRIOR_DEFAULT_SHADER_BIND_FAILED";
+        } else {
+            performed = true;
+            const bool ok = scene->wx_lab_prewarm_default_3d_shader();
+            status = ok ? "prewarmed" : "error";
+            if (!ok) error_code = "DEFAULT_SHADER_BIND_FAILED";
+        }
+    }
+    const uint64_t after = os ? os->get_ticks_usec() : 0;
+    const bool timer_valid = os && after >= before && after - before <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max());
+    const uint64_t duration = timer_valid ? after - before : 0;
+    if (os && !timer_valid) { status = "error"; error_code = "INVALID_TIMER"; }
+
+    Dictionary result;
+    result["status"] = status;
+    result["duration_ms"] = timer_valid ? Variant(static_cast<double>(duration) / 1000.0) : Variant();
+    result["clock"] = "OS.get_ticks_usec";
+    result["performed"] = performed;
+    result["available"] = available;
+    result["error_code"] = error_code;
+    // Boot native14 trace has finished. This bounded, separate marker is not a Scope.
+    char elapsed[48] = {};
+    if (timer_valid) std::snprintf(elapsed, sizeof(elapsed), "%.3f", static_cast<double>(duration) / 1000.0);
+    else std::snprintf(elapsed, sizeof(elapsed), "null");
+    std::printf("[WX_RUNTIME_PREWARM] {\"schema\":\"wx-runtime-prewarm-v1\",\"scope\":\"default_scene_shader_only\",\"status\":\"%s\",\"duration_ms\":%s,\"clock\":\"OS.get_ticks_usec\",\"performed\":%s,\"available\":%s,\"error_code\":\"%s\"}\n",
+            status, elapsed, performed ? "true" : "false", available ? "true" : "false", error_code);
+    return result;
+}
+#endif
diff --git a/platform/web/wx_lab_startup_control.h b/platform/web/wx_lab_startup_control.h
new file mode 100644
